<CLISH_MODULE xmlns="http://www.dellemc.com/sonic/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xsi:schemaLocation="http://www.dellemc.com/sonic/XMLSchema http://www.dellemc.com/sonic/XMLSchema/clish.xsd">
  <VIEW name="enable-view">
    <COMMAND name="show dcbx" help="Display DCBX information and statistics">
      <PARAM name="tlv" help="Display DCBX information and statistics" mode="switch" ptype="SUBCOMMAND" optional="true">
        <PARAM name="pfc" help="Show PFC TLV" mode="subcommand" ptype="SUBCOMMAND">
          <PARAM name="interface" help="Show DCBX information of interface" mode="subcommand" ptype="SUBCOMMAND" optional="true">
            <PARAM name="ifname" help="Physical Interface" ptype="PHY_INTERFACE"/>
          </PARAM>
        </PARAM>
        <PARAM name="ets" help="Show ETS TLV" mode="subcommand" ptype="SUBCOMMAND">
          <PARAM name="interface" help="Show DCBX information of interface" mode="subcommand" ptype="SUBCOMMAND" optional="true">
            <PARAM name="ifname" help="Physical Interface" ptype="PHY_INTERFACE"/>
          </PARAM>
        </PARAM>
        <PARAM name="interface" help="Show DCBX information of interface" mode="subcommand" ptype="SUBCOMMAND">
          <PARAM name="ifname" help="Physical Interface" ptype="PHY_INTERFACE"/>
        </PARAM>
      </PARAM>
      <ACTION builtin="clish_pyobj"> sonic_cli_dcbx get_openconfig_dcbx_dcbx_interfaces show_dcbx.j2 ${tlv} ${ifname}</ACTION>
      <DOCGEN>
        <DESCRIPTION>
              Displays DCBX information and statistics.
          </DESCRIPTION>
        <USAGE>
             This command is useful to view the DCBX information.
          </USAGE>
        <EXAMPLE summary="Shows DCBX information and statistics">
                   sonic-cli# show dcbx
                   ets        Show Ets
                   pfc        Show Pfc
                   interface  DCBX information of interface
          </EXAMPLE>
        <FEATURE> DCBX </FEATURE>
      </DOCGEN>
      <xi:include href="include/pipe.xml"/>
    </COMMAND>
    <COMMAND name="show dcbx statistics" help="Display DCBX statistics information">
      <PARAM name="interface" help="Show DCBX information of interface" mode="subcommand" ptype="SUBCOMMAND" optional="true">
        <PARAM name="ifname" help="Interface name" ptype="PHY_INTERFACE"/>
      </PARAM>
      <ACTION builtin="clish_pyobj"> sonic_cli_dcbx get_openconfig_dcbx_dcbx_interfaces show_dcbx_stats.j2 ${interface} ${ifname}</ACTION>
      <DOCGEN>
        <DESCRIPTION>
             Shows DCBX statistics information
          </DESCRIPTION>
        <USAGE>
             This command is useful to view the DCBX statistics information
          </USAGE>
        <EXAMPLE summary="Display DCBX statistics information">
           sonic-cli# show dcbx statistics interface Ethernet92
           DCBX Statistics
           ---------------------------------------------
           Interface: Ethernet92
           Transmitted PFC                   :22
           Received    PFC                   :22
           Err transmitted PFC               :0
           Err received PFC                  :0
           Last PFC received                 :2 sec
           Last PFC transmitted              :2 sec
           Transmitted ETS conf              :25
           Received ETS conf                 :25
           Err transmitted ETS conf          :0
           Err received ETS conf             :0
           Last ETS conf transmitted         :1 sec 
           Last ETS conf received            :1 sec
           Transmitted ETS reco              :25
           Received ETS reco                 :25
           Err transmitted ETS reco          :0
           Err received ETS reco             :0
           Last ETS reco transmitted         :1 sec
           Last ETS reco received            :1 sec
          </EXAMPLE>
        <FEATURE> DCBX </FEATURE>
      </DOCGEN>
      <xi:include href="include/pipe.xml"/>
    </COMMAND>
  </VIEW>
  <VIEW name="configure-view">
    <COMMAND name="dcbx" access="netadmin" help="Enable DCBX at global level" command_tables="sonic-dcbx:sonic-dcbx/DCBX/global">
      <PARAM name="enable" help="Administratively enable dcbx" ptype="SUBCOMMAND" mode="subcommand" dbpath="sonic-dcbx:sonic-dcbx/DCBX/global/enabled=true"> </PARAM>
      <ACTION builtin="clish_pyobj">sonic_cli_dcbx enable_dcbx_global</ACTION>
      <DOCGEN>
        <DESCRIPTION>
             Enable DCBX at global level
  	 </DESCRIPTION>
        <USAGE>
  	    Use this command to enable DCBX globally
  	 </USAGE>
        <EXAMPLE summary="Enable DCBX at global level">
  				sonic-cli(config)# dcbx enable
  	 </EXAMPLE>
        <FEATURE> DCBX </FEATURE>
      </DOCGEN>
    </COMMAND>
    <COMMAND name="no dcbx" access="netadmin" help="Disable DCBX at global level">
      <PARAM name="enable" help="Administratively disable dcbx" ptype="SUBCOMMAND" mode="subcommand"> </PARAM>
      <ACTION builtin="clish_pyobj">sonic_cli_dcbx disable_dcbx_global</ACTION>
      <DOCGEN>
        <DESCRIPTION>
             Disable DCBX at global level.
  	 </DESCRIPTION>
        <USAGE>
  	    Use this command to disable DCBX globally.
  	 </USAGE>
        <EXAMPLE summary="Disable DCBX at global level">
  			sonic-cli(config)# no dcbx enable
  	 </EXAMPLE>
        <FEATURE> DCBX </FEATURE>
      </DOCGEN>
    </COMMAND>
  </VIEW>
  <!--MODE : interface -->
  <VIEW name="configure-if-view">
    <COMMAND name="dcbx" access="netadmin" help="Enable DCBX at interface level">
      <PARAM name="enable" help="Administratively enable DCBX" ptype="SUBCOMMAND" mode="subcommand"> </PARAM>
      <ACTION builtin="clish_pyobj">sonic_cli_dcbx enable_dcbx_intf ${iface}</ACTION>
      <DOCGEN>
        <DESCRIPTION>
             Enable DCBX at interface level
  	 </DESCRIPTION>
        <USAGE>
  	    Use this command to enable DCBX at interface
  	 </USAGE>
        <EXAMPLE summary="Enable DCBX at interface level">
  		sonic-cli(config)# interface Ethernet 0
 		sonic-cli(conf-if-Ethernet0)# no dcbx enable
  	 </EXAMPLE>
        <FEATURE> DCBX </FEATURE>
      </DOCGEN>
    </COMMAND>
    <COMMAND name="no dcbx" access="netadmin" help="Disable DCBX at interface" command_tables="sonic-dcbx:sonic-dcbx/DCBX_INTERFACE/DCBX_INTERFACE_LIST/ifname={name}">
      <PARAM name="enable" help="Administratively disable DCBX" ptype="SUBCOMMAND" mode="subcommand" dbpath="sonic-dcbx:sonic-dcbx/DCBX_INTERFACE/DCBX_INTERFACE_LIST/dcbx_enabled=false"> </PARAM>
      <ACTION builtin="clish_pyobj">sonic_cli_dcbx disable_dcbx_intf ${iface} true</ACTION>
      <DOCGEN>
        <DESCRIPTION>
  	    Disable DCBX at interface level.
  	 </DESCRIPTION>
        <USAGE>
  	    Use this command to disable DCBX globally.
  	 </USAGE>
        <EXAMPLE summary="Disable DCBX at interface level">
  		sonic-cli(config)# interface Ethernet 0
 		sonic-cli(conf-if-Ethernet0)# no dcbx enable
  	 </EXAMPLE>
        <FEATURE> DCBX </FEATURE>
      </DOCGEN>
    </COMMAND>
    <COMMAND name="dcbx tlv-select" access="netadmin" help="Enables DCBX TLVs">
      <PARAM name="tlv" help="Enables DCBX TLVs" mode="switch" ptype="SUBCOMMAND">
        <PARAM name="pfc" help="Enable PFC TLV" mode="subcommand" ptype="SUBCOMMAND"> </PARAM>
        <PARAM name="ets-conf" help="Enable ETS Configuration TLV" mode="subcommand" ptype="SUBCOMMAND"> </PARAM>
        <PARAM name="ets-reco" help="Enable ETS recommendation TLV" mode="subcommand" ptype="SUBCOMMAND"> </PARAM>
      </PARAM>
      <ACTION builtin="clish_pyobj">sonic_cli_dcbx enable_dcbx_intf_tlv ${iface} ${tlv}</ACTION>
      <DOCGEN>
        <DESCRIPTION>
 	    Enables DCBX TLVs.
          </DESCRIPTION>
        <USAGE>
 	    Use this command to select which DCBX TLVs is to be advertised.
          </USAGE>
        <EXAMPLE summary="Enables DCBX TLVs">
 		sonic-cli(config)# interface Ethernet 0
 		sonic-cli(conf-if-Ethernet0)# dcbx tlv-select pfc
 		sonic-cli(conf-if-Ethernet0)# dcbx tlv-select ets-conf
 		sonic-cli(conf-if-Ethernet0)# dcbx tlv-select ets-reco
          </EXAMPLE>
        <FEATURE> DCBX </FEATURE>
      </DOCGEN>
    </COMMAND>
    <COMMAND name="no dcbx tlv-select" access="netadmin" help="Disables DCBX TLVs" command_tables="sonic-dcbx:sonic-dcbx/DCBX_INTERFACE/DCBX_INTERFACE_LIST/ifname={name}" render_command_cb="dcbx_tlv_select">
      <PARAM name="tlv" help="Disables DCBX TLVs" mode="switch" ptype="SUBCOMMAND">
        <PARAM name="pfc" help="Disable PFC TLV" mode="subcommand" ptype="SUBCOMMAND"> </PARAM>
        <PARAM name="ets-conf" help="Disable ETS Configuration TLV" mode="subcommand" ptype="SUBCOMMAND"> </PARAM>
        <PARAM name="ets-reco" help="Disable ETS recommendation TLV" mode="subcommand" ptype="SUBCOMMAND"> </PARAM>
      </PARAM>
      <ACTION builtin="clish_pyobj">sonic_cli_dcbx disable_dcbx_intf_tlv ${iface} ${tlv}</ACTION>
      <DOCGEN>
        <DESCRIPTION>
             Disables DCBX TLVs.
          </DESCRIPTION>
        <USAGE>
 	    Use this command to select which DCBX TLVs to be disabled.
          </USAGE>
        <EXAMPLE summary="Disables DCBX TLVs">
 		sonic-cli(config)# interface Ethernet 0
                 sonic-cli(conf-if-Ethernet0)# no dcbx tlv-select pfc
 		sonic-cli(conf-if-Ethernet0)# no dcbx tlv-select ets-conf
 		sonic-cli(conf-if-Ethernet0)# no dcbx tlv-select ets-reco
          </EXAMPLE>
        <FEATURE> DCBX </FEATURE>
      </DOCGEN>
    </COMMAND>
  </VIEW>
</CLISH_MODULE>
