<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE CLISH_MODULE [
<!ENTITY START_PORT_ID "1">
<!ENTITY MAX_PORT_ID "32">
<!ENTITY START_SUB_PORT_ID "1">
<!ENTITY MAX_SUB_PORT_ID "4">
<!ENTITY MAX_MTU "9216">
]>
<CLISH_MODULE xmlns="http://www.dellemc.com/sonic/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xsi:schemaLocation="http://www.dellemc.com/sonic/XMLSchema http://www.dellemc.com/sonic/XMLSchema/clish.xsd">
  <PTYPE name="PTP_V6SCOPE_TYPE" pattern="0[xX][0-9a-fA-F]" help="Hexadecimal range (0x0 to 0xf)"/>
  <PTYPE name="PTP_RANGE_2_255" method="integer" pattern="2..255" help=""/>
  <PTYPE name="PTP_RANGE_0_127" method="integer" pattern="0..127" help=""/>
  <VAR name="timesync_ptp_supported" dynamic="false">
    <ACTION builtin="clish_pyobj"> sonic_cli_ptp timesync_ptp_support </ACTION>
  </VAR>
  <VIEW name="enable-view">
    <!--show ptp -->
    <COMMAND name="show ptp" help="Display PTP brief info and status">
      <ACTION builtin="clish_pyobj"> sonic_cli_ptp get_ietf_ptp_ptp_instance_list 0 ptp_show.j2 ${__full_line__} </ACTION>
      <DOCGEN>
        <DESCRIPTION>
 					Display PTP status/configuration
 				</DESCRIPTION>
        <EXAMPLE>
 					sonic# show ptp
 					-----------------------------------------------------------
 					Interface            State
 					-----------------------------------------------------------
 					Ethernet56           master
 					Ethernet64           slave
 				</EXAMPLE>
      </DOCGEN>
      <xi:include href="include/pipe.xml"/>
    </COMMAND>
    <COMMAND name="show running-configuration ptp" access="netadmin:secadmin" help="Display current ptp configuration">
      <ACTION builtin="clish_pyobj">sonic_cli_show_config show_view views=renderCfg_ptp </ACTION>
      <xi:include href="include/pipe.xml"/>
    </COMMAND>
    <COMMAND name="show ptp time-property" help="Display PTP time property status">
      <ACTION builtin="clish_pyobj"> sonic_cli_ptp get_ietf_ptp_ptp_instance_list_time_properties_ds 0 ptp_tp_show.j2 ${__full_line__} </ACTION>
      <DOCGEN>
        <DESCRIPTION>
 					Display PTP time-property status
 				</DESCRIPTION>
        <EXAMPLE>
 					sonic# show ptp time-property
 					Curr UTC Offset Vld  False
 					Curr UTC Offset      37
 					Leap59               False
 					Leap61               False
 					Time Traceable       False
 					Freq Traceable       False
 					PTP Timescale        True
 				</EXAMPLE>
      </DOCGEN>
      <xi:include href="include/pipe.xml"/>
    </COMMAND>
    <COMMAND name="show ptp clock" help="Display PTP configuration">
      <ACTION builtin="clish_pyobj"> sonic_cli_ptp show_ptp_clock 0 ptp_clock_show.j2 0 ptp_currentds_show.j2 ${__full_line__} </ACTION>
      <DOCGEN>
        <DESCRIPTION>
 					Display PTP clock configuration/status
 				</DESCRIPTION>
        <EXAMPLE>
 					sonic# show ptp clock
 					Mode                  BC
 					Domain Profile        ieee1588
 					Network Transport     UDPv4 unicast
 					Domain Number         1
 					Clock Identity        3c2c99.fffe.2d7c35
 					Priority1             128
 					Priority2             128
 					Two Step              Enabled
 					Slave Only            False
 					Number Ports          2
 					Clock Quality:
 					Clock Class         248
 					Clock Accuracy      254
 					Ofst Scaled Log Var 65535
 					Mean Path Delay       0
 					Steps Removed         0
 					Offset from master    0
 				</EXAMPLE>
      </DOCGEN>
      <xi:include href="include/pipe.xml"/>
    </COMMAND>
    <!--show ptp clock detail -->
    <COMMAND name="show ptp clock detail" help="Display PTP Clock config detail" test="${timesync_ptp_supported}">
      <ACTION builtin="clish_pyobj"> sonic_cli_ptp show_ptp_clock_detail 0 ptp_clock_show.j2 0 ptp_show_clock_detail.j2 0 ptp_currentds_show.j2 0 ptp_show_clock_detail_intf.j2 ${__full_line__} </ACTION>
      <DOCGEN>
        <DESCRIPTION>
 					Display PTP Clock config detail status:
 				</DESCRIPTION>
        <EXAMPLE>
 					sonic# show ptp clock detail
 					PTP Clock             BC
 					Clock Identity        3c2c99.fffe.2d7c35
 					Clock Mode            Two Step
 					Clock Quality:
 					  Clock Class         248
 					  Clock Accuracy      254
 					  Offset Scaled Log   65535
 					Domain Profile        ieee1588
 					Domain Number         1
 					Priority1             128
 					Priority2             128
 					Slave Only            False
 					Number Ports          2
 					Grandmaster Identity  3c99cc.fffe.1c7b35
 					Mean Path Delay       0
 					Steps Removed         0
 					Offset from master    0
 					-----------------------------------------------------------
 					Interface            State		Port Number
 					-----------------------------------------------------------
 					Ethernet56           master		1
 					Ethernet64           slave		2
 					Number of slave ports    : 1
 					Number of master ports   : 1
 				</EXAMPLE>
      </DOCGEN>
      <xi:include href="include/pipe.xml"/>
    </COMMAND>
    <COMMAND name="show ptp parent" help="Display PTP parent info">
      <ACTION builtin="clish_pyobj"> sonic_cli_ptp get_ietf_ptp_ptp_instance_list_parent_ds 0 ptp_parent_show.j2 ${__full_line__} </ACTION>
      <DOCGEN>
        <DESCRIPTION>
 					Display PTP parent status
 				</DESCRIPTION>
        <EXAMPLE>
 					sonic# show ptp parent
 					Parent Clock Identity          3c2c99.fffe.2d7c35
 					Port Number                    0
 					Grandmaster Clock Class        248
 					Grandmaster Off Scaled Log Var 65535
 					Grandmaster Clock Accuracy     254
 					Grandmaster Identity           3c2c99.fffe.2d7c35
 					Grandmaster Priority1          128
 					Grandmaster Priority2          128
 					Stats Valid                    False
 					Observed Off Scaled Log Var    65535
 					Observed Clock Phase Chg Rate  2147483647
 				</EXAMPLE>
      </DOCGEN>
      <xi:include href="include/pipe.xml"/>
    </COMMAND>
    <COMMAND name="show ptp port" help="Display PTP port configuration">
      <PARAM name="cfg-if-type" help="Interface type" mode="switch" ptype="SUBCOMMAND">
        <PARAM name="Ethernet" help="Ethernet interface type" ptype="PHY_INTERFACE"/>
        <!-- Comment out portchannel support <PARAM name="PortChannel" help="PortChannel Interface type" ptype="SUBCOMMAND" mode="subcommand"> <PARAM name="ptp_port_number" help="Enter PTP port number" ptype="UINT"/> </PARAM> -->
      </PARAM>
      <ACTION builtin="clish_pyobj"> sonic_cli_ptp get_ietf_ptp_ptp_instance_list_port_ds_list 0 ${Ethernet} ptp_port_show.j2 ${__full_line__} </ACTION>
      <DOCGEN>
        <DESCRIPTION>
 					Display PTP port status/configuration
 				</DESCRIPTION>
        <EXAMPLE>
 					sonic# show ptp port Ethernet 64
 					Port Number                    64
 					Port State                     master
 					Log Min delay Req Intvl        0
 					Peer Mean Path Delay           0
 					Log Announce Interval          1
 					Log Sync Interval              0
 					Log Min PDelay Req Interval    0
 					Version Number                 2
 					Unicast Master Table:
 					                               10.1.1.1
 				</EXAMPLE>
      </DOCGEN>
      <xi:include href="include/pipe.xml"/>
    </COMMAND>
    <!--show ptp servo-->
    <COMMAND name="show ptp servo" help="Display PTP clock servo status" test="${timesync_ptp_supported}">
      <ACTION builtin="clish_pyobj"> sonic_cli_ptp get_ietf_ptp_ptp_instance_list_servo_info 0 ptp_servo.j2 ${__full_line__} </ACTION>
      <DOCGEN>
        <DESCRIPTION>
 					Display PTP clock servo status
 				</DESCRIPTION>
        <EXAMPLE>
 					sonic# show ptp servo
 					Servo State          : Locked
 					Lock Status          : Phase-Locked
 				</EXAMPLE>
      </DOCGEN>
      <xi:include href="include/pipe.xml"/>
    </COMMAND>
    <COMMAND name="show debug" help="Show debug commands" test="${timesync_ptp_supported}"/>
    <COMMAND name="show debug ptp" help="Display debug commands enabled for ptp" test="${timesync_ptp_supported}">
      <ACTION builtin="clish_pyobj"> sonic_cli_ptp get_debug_ptp 0 ptp_debug_show.j2 ${__full_line__} </ACTION>
      <DOCGEN>
        <DESCRIPTION>
                                         Display debug commands enabled for ptp
                                 </DESCRIPTION>
        <EXAMPLE>
                                         sonic# show debug ptp
                                         PTP Debug Settings:
                                         Debug PTP : ALL  Level : 1
                                         Debug PTP : BMCA  Level : 1
                                         Debug PTP : PROTOCOL  Level : 1
                                         Debug PTP : SERVO  Level : 1
                                         Debug PTP : SYSTEM  Level : 1
                                         Debug PTP : TIMESTAMPS  Level : 1
                                 </EXAMPLE>
      </DOCGEN>
      <xi:include href="include/pipe.xml"/>
    </COMMAND>
    <COMMAND name="debug ptp" access="netadmin" help="Enable debug logs of PTP stack" ptype="SUBCOMMAND" test="${timesync_ptp_supported}">
      <PARAM name="debug Options" help="Choose one option" ptype="SUBCOMMAND" mode="switch">
        <PARAM name="all" help="Enable PTP all debug logs of system,stack and servo" mode="subcommand" ptype="SUBCOMMAND"> </PARAM>
        <PARAM name="bmca" help="Enable PTP BMCA (Best timeTransmitter Clock Algorithm) logs" mode="subcommand" ptype="SUBCOMMAND"> </PARAM>
        <PARAM name="protocol" help="Enable PTP protocol engine and transport layer logs" mode="subcommand" ptype="SUBCOMMAND"> </PARAM>
        <PARAM name="servo" help="Enable PTP servo and PLL logs" mode="subcommand" ptype="SUBCOMMAND"> </PARAM>
        <PARAM name="system" help="Enable PTP System and task logs" mode="subcommand" ptype="SUBCOMMAND"> </PARAM>
        <PARAM name="timestamps" help="Enable PTP Timestamp related logs" mode="subcommand" ptype="SUBCOMMAND"> </PARAM>
      </PARAM>
      <PARAM name="level" help="Configure the debug level of the debug option" mode="subcommand" ptype="SUBCOMMAND" optional="true">
        <PARAM name="debug-level-value" help="Value used to specify the debug level (default=1)" ptype="RANGE_1_5"> </PARAM>
      </PARAM>
      <ACTION builtin="clish_pyobj">sonic_cli_ptp patch_debug_ptp all:${all} bmca:${bmca} servo:${servo} protocol:${protocol} system:${system} timestamps:${timestamps} debug-level-value:${debug-level-value}</ACTION>
    </COMMAND>
    <COMMAND name="no debug ptp" access="netadmin" help="Disable debug logs of PTP stack" ptype="SUBCOMMAND" test="${timesync_ptp_supported}">
      <PARAM name="debug Options" help="Choose one option" ptype="SUBCOMMAND" mode="switch">
        <PARAM name="all" help="Disable PTP all debug logs of system,stack and servo" mode="subcommand" ptype="SUBCOMMAND"> </PARAM>
        <PARAM name="bmca" help="Disable PTP BMCA (Best timeTransmitter Clock Algorithm) logs" mode="subcommand" ptype="SUBCOMMAND"> </PARAM>
        <PARAM name="protocol" help="Disable PTP protocol engine and transport layer logs" mode="subcommand" ptype="SUBCOMMAND"> </PARAM>
        <PARAM name="servo" help="Disable PTP servo and PLL logs" mode="subcommand" ptype="SUBCOMMAND"> </PARAM>
        <PARAM name="system" help="Disable PTP System and task logs" mode="subcommand" ptype="SUBCOMMAND"> </PARAM>
        <PARAM name="timestamps" help="Disable PTP Timestamp related logs" mode="subcommand" ptype="SUBCOMMAND"> </PARAM>
      </PARAM>
      <PARAM name="level" help="Reset the debug level of the debug option to 1" mode="subcommand" ptype="SUBCOMMAND" optional="true"> </PARAM>
      <ACTION builtin="clish_pyobj">sonic_cli_ptp delete_debug_ptp all:${all} bmca:${bmca} servo:${servo} protocol:${protocol} system:${system} timestamps:${timestamps} level:${level}</ACTION>
    </COMMAND>
  </VIEW>
  <VIEW name="configure-view">
    <COMMAND name="ptp" access="netadmin" help="Configure precision time protocol settings"/>
    <COMMAND name="ptp mode" access="netadmin" help="Configure PTP mode" command_keys="instance=GLOBAL" command_tables="sonic-ptp:sonic-ptp/PTP_CLOCK/PTP_CLOCK_LIST/instance-number={instance}" render_command_cb="ptp_mode" render_command_viewid="renderCfg_ptp">
      <PARAM name="mode_type" help="PTP mode" ptype="PTP_MODE" dbpath="sonic-ptp:sonic-ptp/PTP_CLOCK/PTP_CLOCK_LIST/clock-type"/>
      <ACTION builtin="clish_pyobj"> sonic_cli_ptp clock-type 0 ${mode_type} </ACTION>
      <DOCGEN>
        <DESCRIPTION>
 					Configure PTP clock type
 				</DESCRIPTION>
        <EXAMPLE>
 					sonic(config)# ptp mode boundary-clock
 					Success
 				</EXAMPLE>
      </DOCGEN>
    </COMMAND>
    <COMMAND name="ptp network-transport" access="netadmin" help="Configure PTP network transport" command_keys="instance=GLOBAL" command_tables="sonic-ptp:sonic-ptp/PTP_CLOCK/PTP_CLOCK_LIST/instance-number={instance}" render_command_cb="ptp_network_transport" render_command_viewid="renderCfg_ptp">
      <PARAM name="ptp_network_transport_type" help="PTP network transport type" ptype="PTP_TRANSPORT" dbpath="sonic-ptp:sonic-ptp/PTP_CLOCK/PTP_CLOCK_LIST/network-transport"/>
      <PARAM name="ptp_master_slave" help="unicast or multicast" ptype="PTP_MST_SLV" dbpath="sonic-ptp:sonic-ptp/PTP_CLOCK/PTP_CLOCK_LIST/unicast-multicast"/>
      <ACTION builtin="clish_pyobj"> sonic_cli_ptp network_transport_uc_mc 0 ${ptp_network_transport_type} 0 ${ptp_master_slave} </ACTION>
      <DOCGEN>
        <DESCRIPTION>
 					Configure PTP network-transport
 				</DESCRIPTION>
        <EXAMPLE>
 					sonic(config)# ptp network-transport ipv4 unicast
 					Success
 				</EXAMPLE>
      </DOCGEN>
    </COMMAND>
    <COMMAND name="ptp ipv6-scope" access="netadmin" help="Configure PTP IPv6 multicast scope" command_keys="instance=GLOBAL" command_tables="sonic-ptp:sonic-ptp/PTP_CLOCK/PTP_CLOCK_LIST/instance-number={instance}" render_command_viewid="renderCfg_ptp">
      <PARAM name="ptp_ipv6_scope" help="Scope used for IPv6 multicast message. Used as second byte of the primary address" ptype="PTP_V6SCOPE_TYPE" dbpath="sonic-ptp:sonic-ptp/PTP_CLOCK/PTP_CLOCK_LIST/udp6-scope"/>
      <ACTION builtin="clish_pyobj"> sonic_cli_ptp udp6-scope 0 ${ptp_ipv6_scope} </ACTION>
      <DOCGEN>
        <DESCRIPTION>
 					Configure PTP IPv6 multicast address scope
 				</DESCRIPTION>
        <EXAMPLE>
 					sonic(config)# ptp ipv6-scope 0xe
 					Success
 				</EXAMPLE>
      </DOCGEN>
    </COMMAND>
    <COMMAND name="ptp domain" access="netadmin" help="Configure PTP domain" command_keys="instance=GLOBAL" command_tables="sonic-ptp:sonic-ptp/PTP_CLOCK/PTP_CLOCK_LIST/instance-number={instance}" render_command_viewid="renderCfg_ptp">
      <PARAM name="ptp_domain" help="PTP domain value" ptype="PTP_RANGE_0_127" dbpath="sonic-ptp:sonic-ptp/PTP_CLOCK/PTP_CLOCK_LIST/domain-number"/>
      <ACTION builtin="clish_pyobj"> sonic_cli_ptp patch_ietf_ptp_ptp_instance_list_default_ds_domain_number 0 ${ptp_domain} </ACTION>
      <DOCGEN>
        <DESCRIPTION>
 					Configure PTP domain
 				</DESCRIPTION>
        <EXAMPLE>
 					sonic(config)# ptp domain 1
 					Success
 				</EXAMPLE>
      </DOCGEN>
    </COMMAND>
    <COMMAND name="ptp domain-profile" access="netadmin" help="Configure PTP domain profile" command_keys="instance=GLOBAL" command_tables="sonic-ptp:sonic-ptp/PTP_CLOCK/PTP_CLOCK_LIST/instance-number={instance}" render_command_cb="ptp_domain_profile" render_command_viewid="renderCfg_ptp">
      <PARAM name="ptp_domain_profile" help="PTP domain profile type" ptype="PTP_DOMAIN_PROFILE" dbpath="sonic-ptp:sonic-ptp/PTP_CLOCK/PTP_CLOCK_LIST/domain-profile"/>
      <ACTION builtin="clish_pyobj"> sonic_cli_ptp domain-profile 0 ${ptp_domain_profile} </ACTION>
      <DOCGEN>
        <DESCRIPTION>
 					Configure PTP domain profile
 				</DESCRIPTION>
        <EXAMPLE>
 					sonic(config)# ptp domain-profile default
 					Success
 				</EXAMPLE>
      </DOCGEN>
    </COMMAND>
    <COMMAND name="ptp two-step" access="netadmin" help="Configure PTP two step enable" command_keys="instance=GLOBAL" command_tables="sonic-ptp:sonic-ptp/PTP_CLOCK/PTP_CLOCK_LIST/instance-number={instance}" render_command_cb="ptp_domain_two_step" render_command_viewid="renderCfg_ptp">
      <PARAM name="ptp_two_step" help="Enable/Disable" ptype="ENA_DISA" dbpath="sonic-ptp:sonic-ptp/PTP_CLOCK/PTP_CLOCK_LIST/two-step-flag"/>
      <ACTION builtin="clish_pyobj"> sonic_cli_ptp patch_ietf_ptp_ptp_instance_list_default_ds_two_step_flag 0 ${ptp_two_step} </ACTION>
      <DOCGEN>
        <DESCRIPTION>
 					Configure PTP two-step mode
 				</DESCRIPTION>
        <EXAMPLE>
 					sonic(config)# ptp two-step enable
 					Success
 				</EXAMPLE>
      </DOCGEN>
    </COMMAND>
    <COMMAND name="ptp priority1" access="netadmin" help="Configure PTP priority1" command_keys="instance=GLOBAL" command_tables="sonic-ptp:sonic-ptp/PTP_CLOCK/PTP_CLOCK_LIST/instance-number={instance}" render_command_viewid="renderCfg_ptp">
      <PARAM name="ptp_priority1" help="PTP priority1 value" ptype="RANGE_0_255" dbpath="sonic-ptp:sonic-ptp/PTP_CLOCK/PTP_CLOCK_LIST/priority1"/>
      <ACTION builtin="clish_pyobj"> sonic_cli_ptp patch_ietf_ptp_ptp_instance_list_default_ds_priority1 0 ${ptp_priority1} </ACTION>
      <DOCGEN>
        <DESCRIPTION>
 					Configure PTP priority1 value
 				</DESCRIPTION>
        <EXAMPLE>
 					sonic(config)# ptp priority1 128
 					Success
 				</EXAMPLE>
      </DOCGEN>
    </COMMAND>
    <COMMAND name="ptp priority2" access="netadmin" help="Configure PTP priority2" command_keys="instance=GLOBAL" command_tables="sonic-ptp:sonic-ptp/PTP_CLOCK/PTP_CLOCK_LIST/instance-number={instance}" render_command_viewid="renderCfg_ptp">
      <PARAM name="ptp_priority2" help="PTP priority2 value" ptype="RANGE_0_255" dbpath="sonic-ptp:sonic-ptp/PTP_CLOCK/PTP_CLOCK_LIST/priority2"/>
      <ACTION builtin="clish_pyobj"> sonic_cli_ptp patch_ietf_ptp_ptp_instance_list_default_ds_priority2 0 ${ptp_priority2} </ACTION>
      <DOCGEN>
        <DESCRIPTION>
 					Configure PTP priority2 value
 				</DESCRIPTION>
        <EXAMPLE>
 					sonic(config)# ptp priority2 128
 					Success
 				</EXAMPLE>
      </DOCGEN>
    </COMMAND>
    <COMMAND name="ptp source-interface" access="netadmin" help="Configure the source interface to pick the IP for PTP multicast communication" ptype="SUBCOMMAND" mode="subcommand" command_keys="instance=GLOBAL" command_tables="sonic-ptp:sonic-ptp/PTP_CLOCK/PTP_CLOCK_LIST/instance-number={instance}" render_command_cb="ptp_source_if" test="${timesync_ptp_supported}" render_command_viewid="renderCfg_ptp">
      <PARAM name="iftype" help="Interface type" mode="switch" ptype="SUBCOMMAND">
        <PARAM name="Ethernet" help="Ethernet interface or sub-interface" ptype="PHY_INTERFACE_SUBIF" mode="subcommand"> </PARAM>
        <PARAM name="Loopback" help="Loopback interface" ptype="LOOPBACK_INTERFACE" mode="subcommand"> </PARAM>
        <PARAM name="PortChannel" help="PortChannel interface or sub-interface" ptype="PO_INTERFACE_SUBIF" mode="subcommand"> </PARAM>
        <PARAM name="Vlan" help="VLAN interface" ptype="VLAN_INTERFACE" mode="subcommand"> </PARAM>
      </PARAM>
      <ACTION builtin="clish_pyobj"> sonic_cli_ptp patch_ietf_ptp_ptp_instance_list_default_ds_source_intf 0 ${Ethernet} ${Loopback} ${PortChannel} ${Vlan} </ACTION>
      <DOCGEN>
        <DESCRIPTION>
 					Configure PTP source interface in configuration mode. PTP source interface can be
 					an ethernet, loopback, management, port channel or vlan interface.
 				</DESCRIPTION>
        <USAGE>
 					sonic(config)# ptp source-interface INTERFACE
 						INTERFACE    Ethernet interface
 						Loopback     Loopback interface
 						PortChannel  PortChannel interface
 						Vlan         Vlan interface
 				</USAGE>
        <EXAMPLE summary="Configure PTP source interface">
 					sonic# configure
 					sonic(config)# ptp source-interface Ethernet 0
 					sonic(config)# ptp source-interface Ethernet 0.1
 					sonic(config)# ptp source-interface Loopback 88
 					sonic(config)# ptp source-interface PortChannel 18
 					sonic(config)# ptp source-interface Vlan 888
 				</EXAMPLE>
      </DOCGEN>
    </COMMAND>
    <COMMAND name="ptp log-announce-interval" access="netadmin" help="Configure PTP announce interval" command_keys="instance=GLOBAL" command_tables="sonic-ptp:sonic-ptp/PTP_CLOCK/PTP_CLOCK_LIST/instance-number={instance}" render_command_viewid="renderCfg_ptp">
      <PARAM name="ptp_announce_interval" help="PTP announce interval value" ptype="INT8_RANGE" dbpath="sonic-ptp:sonic-ptp/PTP_CLOCK/PTP_CLOCK_LIST/log-announce-interval"/>
      <ACTION builtin="clish_pyobj"> sonic_cli_ptp patch_ietf_ptp_ptp_instance_list_port_ds_list_log_announce_interval 0 ${ptp_announce_interval} </ACTION>
      <DOCGEN>
        <DESCRIPTION>
 					Configure PTP log announce interval value. The interval should be the sam in the whole domain. It's specified as a power of two in seconds. The default is 1 (2 seconds).
 				</DESCRIPTION>
        <EXAMPLE>
 					sonic(config)# ptp log-announce-interval 0
 					Success
 				</EXAMPLE>
      </DOCGEN>
    </COMMAND>
    <COMMAND name="ptp announce-timeout" access="netadmin" help="Configure PTP announce timeout" command_keys="instance=GLOBAL" command_tables="sonic-ptp:sonic-ptp/PTP_CLOCK/PTP_CLOCK_LIST/instance-number={instance}" render_command_viewid="renderCfg_ptp">
      <PARAM name="ptp_announce_timeout" help="Announce timeout.&#10; G.8275.1 : Default 3 in the range of [3 to 10]&#10; G.8275.2 : Default 3 in the range of [2 to 10]&#10; Default : Default 3 in the range of [2 to 10]" ptype="UNSIGNED_RANGE_2_10" dbpath="sonic-ptp:sonic-ptp/PTP_CLOCK/PTP_CLOCK_LIST/announce-receipt-timeout"/>
      <ACTION builtin="clish_pyobj"> sonic_cli_ptp patch_ietf_ptp_ptp_instance_list_port_ds_list_announce_receipt_timeout 0 ${ptp_announce_timeout} </ACTION>
      <DOCGEN>
        <DESCRIPTION>
 					Configure PTP announce receipt timeout value. The default value is 3.
 				</DESCRIPTION>
        <EXAMPLE>
 					sonic(config)# ptp announce-timeout 2
 					Success
 				</EXAMPLE>
      </DOCGEN>
    </COMMAND>
    <COMMAND name="ptp log-sync-interval" access="netadmin" help="Configure PTP sync interval" command_keys="instance=GLOBAL" command_tables="sonic-ptp:sonic-ptp/PTP_CLOCK/PTP_CLOCK_LIST/instance-number={instance}" render_command_viewid="renderCfg_ptp">
      <PARAM name="ptp_sync_interval" help="PTP sync interval value" ptype="INT8_RANGE" dbpath="sonic-ptp:sonic-ptp/PTP_CLOCK/PTP_CLOCK_LIST/log-sync-interval"/>
      <ACTION builtin="clish_pyobj"> sonic_cli_ptp patch_ietf_ptp_ptp_instance_list_port_ds_list_log_sync_interval 0 ${ptp_sync_interval} </ACTION>
      <DOCGEN>
        <DESCRIPTION>
 					Configure PTP log sync interval value. It is specified as a power of two in seconds. The default is 0 (1 second).
 				</DESCRIPTION>
        <EXAMPLE>
 					sonic(config)# ptp log-sync-interval 0
 					Success
 				</EXAMPLE>
      </DOCGEN>
    </COMMAND>
    <COMMAND name="ptp log-min-delay-req-interval" access="netadmin" help="Configure PTP delay request interval" command_keys="instance=GLOBAL" command_tables="sonic-ptp:sonic-ptp/PTP_CLOCK/PTP_CLOCK_LIST/instance-number={instance}" render_command_viewid="renderCfg_ptp">
      <PARAM name="ptp_delay_request_interval" help="PTP delay request interval value" ptype="INT8_RANGE" dbpath="sonic-ptp:sonic-ptp/PTP_CLOCK/PTP_CLOCK_LIST/log-min-delay-req-interval"/>
      <ACTION builtin="clish_pyobj"> sonic_cli_ptp patch_ietf_ptp_ptp_instance_list_port_ds_list_log_min_delay_req_interval 0 ${ptp_delay_request_interval} </ACTION>
      <DOCGEN>
        <DESCRIPTION>
 					Configure PTP log min delay req interval value. It is specified as a power of two in seconds. The default is 0 (1 second).
 				</DESCRIPTION>
        <EXAMPLE>
 					sonic(config)# ptp log-min-delay-req-interval 0
 					Success
 				</EXAMPLE>
      </DOCGEN>
    </COMMAND>
    <COMMAND name="ptp port" access="netadmin" help="Configure PTP port settings"/>
    <COMMAND name="ptp port add" access="netadmin" help="Add PTP network interface" command_keys="instance=GLOBAL;interface=*" command_tables="sonic-ptp:sonic-ptp/PTP_PORT/PTP_PORT_LIST/instance-number={instance},underlying-interface={interface}" render_command_cb="ptp_port" render_command_viewid="renderCfg_ptp">
      <PARAM name="cfg-if-type" help="Interface type" mode="switch" ptype="SUBCOMMAND">
        <PARAM name="Ethernet" help="Ethernet interface type" ptype="PHY_INTERFACE" dbpath="sonic-ptp:sonic-ptp/PTP_PORT/PTP_PORT_LIST/underlying-interface">
          <PARAM name="role" help="Configure the interface to operate in master, slave, dynamic" mode="subcommand" ptype="SUBCOMMAND" optional="true" test="${timesync_ptp_supported}">
            <PARAM name="role-options" help="Configure the interface role option" mode="switch" ptype="SUBCOMMAND">
              <PARAM name="dynamic" help="Enable dynamic role on the interface." mode="subcommand" ptype="SUBCOMMAND" dbpath="sonic-ptp:sonic-ptp/PTP_PORT/PTP_PORT_LIST/role"> </PARAM>
              <PARAM name="master" help="Enable master only role on the interface" mode="subcommand" ptype="SUBCOMMAND" dbpath="sonic-ptp:sonic-ptp/PTP_PORT/PTP_PORT_LIST/role"> </PARAM>
              <PARAM name="slave" help="Enable slave only role on the interface" mode="subcommand" ptype="SUBCOMMAND" dbpath="sonic-ptp:sonic-ptp/PTP_PORT/PTP_PORT_LIST/role"> </PARAM>
            </PARAM>
          </PARAM>
          <PARAM name="local-priority" help="Configure the local priority for the profile G.8275.1/G.8275.2" mode="subcommand" ptype="SUBCOMMAND" optional="true" test="${timesync_ptp_supported}">
            <PARAM name="local-priority-value" help="local priority value used by G.8275.1/G.8275.2 profiles(default=128)" ptype="RANGE_1_255" dbpath="sonic-ptp:sonic-ptp/PTP_PORT/PTP_PORT_LIST/local-priority"/>
          </PARAM>
        </PARAM>
        <!-- Comment out portchannel support <PARAM name="PortChannel" help="PortChannel Interface type" ptype="SUBCOMMAND" mode="subcommand"> <PARAM name="ptp_port_number" help="Enter PTP port number" ptype="UINT"/> </PARAM> -->
      </PARAM>
      <ACTION builtin="clish_pyobj"> sonic_cli_ptp post_ietf_ptp_ptp_instance_list_port_ds_list_port_state 0 ${Ethernet} role:${role} dynamic:${dynamic} slave:${slave} master:${master} local-priority:${local-priority} local-priority-value:${local-priority-value} </ACTION>
      <DOCGEN>
        <DESCRIPTION>
 					Add a PTP port
 				</DESCRIPTION>
        <EXAMPLE>
 				sonic(config)# ptp port add Ethernet 64
 				Success
 				</EXAMPLE>
      </DOCGEN>
    </COMMAND>
    <COMMAND name="ptp port del" access="netadmin" help="Delete PTP network interface" command_keys="instance=GLOBAL;interface=*" command_tables="sonic-ptp:sonic-ptp/PTP_PORT/PTP_PORT_LIST/instance-number={instance},underlying-interface={interface}">
      <PARAM name="cfg-if-type" help="Interface type" mode="switch" ptype="SUBCOMMAND">
        <PARAM name="Ethernet" help="Ethernet interface type" ptype="PHY_INTERFACE">
          <PARAM name="Intf-options" help="Unconfigure the interface subcommands" mode="switch" ptype="SUBCOMMAND" optional="true" test="${timesync_ptp_supported}">
            <PARAM name="role" help="Unconfigure the interface role" mode="subcommand" ptype="SUBCOMMAND"/>
            <PARAM name="local-priority" help="Unconfigure the local priority for the profile" mode="subcommand" ptype="SUBCOMMAND"/>
          </PARAM>
          <!-- Comment out portchannel support <PARAM name="PortChannel" help="PortChannel Interface type" ptype="SUBCOMMAND" mode="subcommand"> <PARAM name="ptp_port_number" help="Enter PTP port number" ptype="UINT"/> </PARAM> -->
        </PARAM>
      </PARAM>
      <ACTION builtin="clish_pyobj"> sonic_cli_ptp delete_ietf_ptp_ptp_instance_list_port_ds_list 0 ${Ethernet} role:${role} local-priority:${local-priority} </ACTION>
      <DOCGEN>
        <DESCRIPTION>
 					Delete a PTP port
 				</DESCRIPTION>
        <EXAMPLE>
 				sonic(config)# ptp port del Ethernet 64
 				Success
 				</EXAMPLE>
      </DOCGEN>
    </COMMAND>
    <COMMAND name="ptp port master-table" access="netadmin" help="Configure PTP master nodes list when this node is configured as slave" command_keys="instance=GLOBAL;interface=*" command_tables="sonic-ptp:sonic-ptp/PTP_PORT/PTP_PORT_LIST/instance-number={instance},underlying-interface={interface}" render_command_cb="ptp_master_table" render_command_viewid="renderCfg_ptp">
      <PARAM name="cfg-if-type" help="Interface type" mode="switch" ptype="SUBCOMMAND">
        <PARAM name="Ethernet" help="Ethernet interface type" ptype="PHY_INTERFACE">
          <PARAM name="cfg_ptp_mt_subcommands" help="PTP master-table subcommands" mode="switch" ptype="SUBCOMMAND">
            <PARAM name="add" help="Add master nodes" ptype="SUBCOMMAND" mode="subcommand">
              <PARAM name="cfg-ptp-master_node" help="PTP master-table subcommands" mode="switch" ptype="SUBCOMMAND">
                <PARAM name="l3_ip" help="IP address" ptype="IPV4V6_ADDR" dbpath="sonic-ptp:sonic-ptp/PTP_PORT/PTP_PORT_LIST/unicast-table"/>
                <PARAM name="mac" help="MAC address" ptype="MAC_ADDR"/>
              </PARAM>
            </PARAM>
            <PARAM name="del" help="Delete master nodes" ptype="SUBCOMMAND" mode="subcommand">
              <PARAM name="cfg-ptp-master_node" help="PTP master-table subcommands" mode="switch" ptype="SUBCOMMAND">
                <PARAM name="l3_ip" help="IP address" ptype="IPV4V6_ADDR"/>
                <PARAM name="mac" help="MAC address" ptype="MAC_ADDR"/>
              </PARAM>
            </PARAM>
          </PARAM>
        </PARAM>
      </PARAM>
      <ACTION builtin="clish_pyobj"> sonic_cli_ptp ${cfg_ptp_mt_subcommands}_master_table 0 ${Ethernet} ${l3_ip}${mac} </ACTION>
      <DOCGEN>
        <DESCRIPTION>
 					Add/Delete a master IP/MAC from the master table for the designated slave port
 				</DESCRIPTION>
        <EXAMPLE>
 				sonic(config)# ptp port master-table Ethernet 64 add 10.1.1.1
 				Success
 				sonic(config)# ptp port master-table Ethernet 64 del 10.1.1.1
 				Success
 				</EXAMPLE>
      </DOCGEN>
    </COMMAND>
