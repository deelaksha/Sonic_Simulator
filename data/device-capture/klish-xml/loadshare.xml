        <PARAM name="offset" help="User-defined field offset in Bytes post IP header" ptype="SUBCOMMAND" mode="subcommand">
          <PARAM name="offset-val" help="UDF offset value" ptype="RANGE_0_127">
            <PARAM name="size" help="User-defined field size" ptype="SUBCOMMAND" mode="subcommand">
              <PARAM name="size-val" help="UDF size value in Bytes" ptype="RANGE_1_128">
                <PARAM name="l3-proto" help="L3 protocol to match traffic flows" ptype="SUBCOMMAND" mode="subcommand">
                  <PARAM name="l3-proto-val" help="L3 protocol value" ptype="RANGE_0_255">
                    <PARAM name="l4-dst-port" help="L4 dst port to match traffic flows" ptype="SUBCOMMAND" mode="subcommand" optional="true">
                      <PARAM name="l4-dst-port-val" help="L4 dst port value" ptype="UINT16"/>
                    </PARAM>
                  </PARAM>
                </PARAM>
              </PARAM>
            </PARAM>
          </PARAM>
        </PARAM>
      </PARAM>
      <ACTION builtin="clish_pyobj">sonic_cli_ip_loadshare patch_loadshare_udf_config ${__params}</ACTION>
      <DOCGEN>
        <DESCRIPTION>
                 Configure ECMP hash user-defined field
             </DESCRIPTION>
        <USAGE>
                 Use this command to configure ECMP hash user-defined field
             </USAGE>
        <EXAMPLE summary="Configure ECMP hash user-defined field">
                 sonic-cli(config)# ip load-share hash udf fld1 offset 13 size 3 l3-proto 17 l4-dst-port 4791
                 sonic-cli(config)# ip load-share hash udf fld1 offset 13 size 3 l3-proto 17
             </EXAMPLE>
      </DOCGEN>
    </COMMAND>
