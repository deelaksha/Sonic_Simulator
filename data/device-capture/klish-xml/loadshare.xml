    <COMMAND name="ip load-share hash udf" access="netadmin" help="Hash user-defined field configuration" ptype="SUBCOMMAND" command_keys="udf_name=*" command_tables="sonic-loadshare-mode:sonic-loadshare-mode/ECMP_LOADSHARE_TABLE_UDF/ECMP_LOADSHARE_TABLE_UDF_LIST/udf-name={udf_name}" render_command_cb="ip_loadshare_config" mode="subcommand">
