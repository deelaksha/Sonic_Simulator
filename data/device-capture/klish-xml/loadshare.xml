    <COMMAND name="ip load-share hash" access="netadmin" help="Hash Parameter Configuration"> </COMMAND>
    <COMMAND name="ip load-share hash offset" access="netadmin" help="Hash Offset Configuration" ptype="SUBCOMMAND" command_tables="sonic-loadshare-mode:sonic-loadshare-mode/ECMP_LOADSHARE_TABLE_OFFSET/ECMP_LOADSHARE_TABLE_OFFSET_LIST/hash=hash" render_command_cb="ip_loadshare_config" mode="subcommand">
      <PARAM name="offsetcmdtype" help="" ptype="SUBCOMMAND" mode="switch">
        <PARAM name="offset-val" help="IP ECMP hash offset value" dbpath="sonic-loadshare-mode:sonic-loadshare-mode/ECMP_LOADSHARE_TABLE_OFFSET/ECMP_LOADSHARE_TABLE_OFFSET_LIST/ecmp-hash-offset" ptype="RANGE_0_15"/>
        <PARAM name="flow-based" help="Enable flow-based based hashing" ptype="SUBCOMMAND" mode="subcommand"/>
      </PARAM>
      <ACTION builtin="clish_pyobj">sonic_cli_ip_loadshare patch_loadshare_offset_config ${__params}</ACTION>
      <DOCGEN>
        <DESCRIPTION>
                 Configure IP ECMP hash offset
             </DESCRIPTION>
        <USAGE>
                 Use this command to configure IP ECMP load share hash offset
             </USAGE>
        <EXAMPLE summary="Configure ip ecmp load share hash offset">
                 sonic-cli(config)# ip load-share hash offset 4
             </EXAMPLE>
      </DOCGEN>
    </COMMAND>
    <COMMAND name="ip load-share hash resilient" access="netadmin" help="Resilient Hash Configuration" ptype="SUBCOMMAND" command_tables="sonic-loadshare-mode:sonic-loadshare-mode/ECMP_LOADSHARE_TABLE_RH/ECMP_LOADSHARE_TABLE_RH_LIST/vrf={vrf},prefix={pfx}" render_command_cb="ip_loadshare_config" mode="subcommand">
      <PARAM name="rhcmdtype" help="" ptype="SUBCOMMAND" mode="switch">
        <PARAM name="nhg-optimization" help="IP ECMP resilient hash optimization threshold" mode="subcommand" dbpath="sonic-switch:sonic-switch/SWITCH/SWITCH_LIST/ecmp_hash_rh_threshold" ptype="SUBCOMMAND">
          <PARAM name="threshold" help="IP ECMP hash optimization threshold value" mode="subcommand" dbpath="sonic-switch:sonic-switch/SWITCH/SWITCH_LIST/ecmp_hash_rh_threshold" ptype="SUBCOMMAND">
            <PARAM name="threshold-val" help="IP ECMP hash optimization threshold value percent" dbpath="sonic-switch:sonic-switch/SWITCH/SWITCH_LIST/ecmp_hash_rh_threshold" ptype="PERCENT_1"> </PARAM>
          </PARAM>
        </PARAM>
        <PARAM name="ip" help="IP ECMP resilient hash ipv4 prefix" mode="subcommand" dbpath="sonic-loadshare-mode:sonic-loadshare-mode/ECMP_LOADSHARE_TABLE_RH/ECMP_LOADSHARE_TABLE_RH_LIST/prefix" ptype="SUBCOMMAND">
          <PARAM name="v4-addr-mask" help="IP ECMP resilient hash ipv4 prefix value" dbpath="sonic-loadshare-mode:sonic-loadshare-mode/ECMP_LOADSHARE_TABLE_RH/ECMP_LOADSHARE_TABLE_RH_LIST/prefix" ptype="IP_ADDR_MASK"/>
          <PARAM name="vrf" help="Vrf for prefix used in resilient hashing" ptype="SUBCOMMAND" mode="subcommand" optional="true">
            <PARAM name="vrfname" help="Name of VRF" ptype="ALL_VRF"> </PARAM>
          </PARAM>
          <PARAM name="size" help="IP ECMP resilient hash size value" mode="subcommand" dbpath="sonic-loadshare-mode:sonic-loadshare-mode/ECMP_LOADSHARE_TABLE_RH/ECMP_LOADSHARE_TABLE_RH_LIST/size" ptype="SUBCOMMAND" optional="true">
            <PARAM name="size-val" help="IP ECMP hash size value - allowed values 64 or 128" dbpath="sonic-loadshare-mode:sonic-loadshare-mode/ECMP_LOADSHARE_TABLE_RH/ECMP_LOADSHARE_TABLE_RH_LIST/size" ptype="RANGE_1_256"> </PARAM>
          </PARAM>
          <PARAM name="seed" help="IP ECMP resilient hash seed value" mode="subcommand" dbpath="sonic-loadshare-mode:sonic-loadshare-mode/ECMP_LOADSHARE_TABLE_RH/ECMP_LOADSHARE_TABLE_RH_LIST/seed" ptype="SUBCOMMAND" optional="true">
            <PARAM name="seed-val" help="IP ECMP resilient hash seed value" dbpath="sonic-loadshare-mode:sonic-loadshare-mode/ECMP_LOADSHARE_TABLE_RH/ECMP_LOADSHARE_TABLE_RH_LIST/seed" ptype="RANGE_0_4294967295"> </PARAM>
          </PARAM>
        </PARAM>
        <PARAM name="ipv6" help="IP ECMP resilient hash ipv6 prefix" mode="subcommand" dbpath="sonic-loadshare-mode:sonic-loadshare-mode/ECMP_LOADSHARE_TABLE_RH/ECMP_LOADSHARE_TABLE_RH_LIST/prefix" ptype="SUBCOMMAND">
          <PARAM name="v6-addr-mask" help="IP ECMP resilient hash ipv6 prefix value" dbpath="sonic-loadshare-mode:sonic-loadshare-mode/ECMP_LOADSHARE_TABLE_RH/ECMP_LOADSHARE_TABLE_RH_LIST/prefix" ptype="IPV6_ADDR_MASK"/>
          <PARAM name="vrf" help="Vrf for prefix used in resilient hashing" ptype="SUBCOMMAND" mode="subcommand" optional="true">
            <PARAM name="vrfname" help="Name of VRF" ptype="ALL_VRF"> </PARAM>
          </PARAM>
          <PARAM name="size" help="IP ECMP resilient hash size value in multiples of 64" mode="subcommand" dbpath="sonic-loadshare-mode:sonic-loadshare-mode/ECMP_LOADSHARE_TABLE_RH/ECMP_LOADSHARE_TABLE_RH_LIST/size" ptype="SUBCOMMAND" optional="true">
            <PARAM name="size-val" help="IP ECMP hash size value" dbpath="sonic-loadshare-mode:sonic-loadshare-mode/ECMP_LOADSHARE_TABLE_RH/ECMP_LOADSHARE_TABLE_RH_LIST/size" ptype="RANGE_1_256"> </PARAM>
          </PARAM>
          <PARAM name="seed" help="IP ECMP resilient hash seed value" mode="subcommand" dbpath="sonic-loadshare-mode:sonic-loadshare-mode/ECMP_LOADSHARE_TABLE_RH/ECMP_LOADSHARE_TABLE_RH_LIST/seed" ptype="SUBCOMMAND" optional="true">
            <PARAM name="seed-val" help="IP ECMP resilient hash seed value" dbpath="sonic-loadshare-mode:sonic-loadshare-mode/ECMP_LOADSHARE_TABLE_RH/ECMP_LOADSHARE_TABLE_RH_LIST/seed" ptype="RANGE_0_4294967295" optional="true"> </PARAM>
          </PARAM>
        </PARAM>
      </PARAM>
      <ACTION builtin="clish_pyobj">sonic_cli_ip_loadshare patch_loadshare_rh_config ${__params}</ACTION>
      <DOCGEN>
        <DESCRIPTION>
                 Configure IP ECMP resilient hash prefix
             </DESCRIPTION>
        <USAGE>
                 Use this command to configure IP ECMP load share resilient hash prefix
             </USAGE>
        <EXAMPLE summary="Configure ip ecmp load share hash resilient v4-prefix">
                 sonic-cli(config)# ip load-share hash resilient v4-prefix 1.1.1.1/24 vrf Vrf-1 size 64 seed 10
             </EXAMPLE>
      </DOCGEN>
    </COMMAND>
    <COMMAND name="ip load-share hash seed" access="netadmin" help="Hash Parameter Configuration" ptype="SUBCOMMAND" command_tables="sonic-loadshare-mode:sonic-loadshare-mode/ECMP_LOADSHARE_TABLE_SEED/ECMP_LOADSHARE_TABLE_SEED_LIST/hash=hash" render_command_cb="ip_loadshare_config" mode="subcommand">
