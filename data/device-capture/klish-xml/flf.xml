<CLISH_MODULE xmlns="http://www.dellemc.com/sonic/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xsi:schemaLocation="http://www.dellemc.com/sonic/XMLSchema http://www.dellemc.com/sonic/XMLSchema/clish.xsd">
  <VAR name="flf_supported" dynamic="true">
    <ACTION builtin="clish_pyobj">sonic_cli_switch_resource is_flf_configurable </ACTION>
  </VAR>
  <VIEW name="configure-view">
    <COMMAND name="flf" access="netadmin" help="Fast Link Failover config" test="${flf_supported}"/>
    <COMMAND name="flf dscp" access="netadmin" help="DSCP value for FLF deflection marking" test="${flf_supported}" mode="subcommand" ptype="SUBCOMMAND" command_keys="switch=*" command_tables="sonic-switch:sonic-switch/SWITCH/SWITCH_LIST/switch={switch}">
      <PARAM name="dscp-value" help="dscp value" ptype="RANGE_0_63" dbpath="sonic-switch:sonic-switch/SWITCH/SWITCH_LIST/flf_dscp"> </PARAM>
      <ACTION builtin="clish_pyobj"> sonic_cli_if add_flf_config_dscp ${dscp-value}
 </ACTION>
    </COMMAND>
    <COMMAND name="no flf" access="netadmin" help="Fast Link Failover unconfig" test="${flf_supported}"/>
    <COMMAND name="no flf dscp" access="netadmin" help="DSCP value for FLF deflection marking unconfig" test="${flf_supported}" mode="subcommand" ptype="SUBCOMMAND" command_keys="switch=*" command_tables="sonic-switch:sonic-switch/SWITCH/SWITCH_LIST/switch={switch}">
      <ACTION builtin="clish_pyobj"> sonic_cli_if delete_flf_config_dscp
 </ACTION>
    </COMMAND>
  </VIEW>
</CLISH_MODULE>
