<CLISH_MODULE xmlns="http://www.dellemc.com/sonic/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xi="http://www.w3.org/2001/XInclude" xsi:schemaLocation="http://www.dellemc.com/sonic/XMLSchema http://www.dellemc.com/sonic/XMLSchema/clish.xsd">
  <VIEW name="configure-view">
    <COMMAND name="interface-naming" access="netadmin" help="Interface naming" test="-z ${__in_session}" command_keys="name=localhost" command_tables="sonic-device-metadata:sonic-device-metadata/DEVICE_METADATA/DEVICE_METADATA_LIST/name={name}" render_command_cb="intf_naming_mode">
      <PARAM name="standard" help="Enable interface naming standard mode" ptype="SUBCOMMAND" mode="subcommand">
        <PARAM name="extended" help="Enable interface naming standard extended mode" ptype="SUBCOMMAND" mode="subcommand" optional="true"> </PARAM>
      </PARAM>
      <ACTION> if test "${extended}" = "" ; then
 python3 $SONIC_CLI_ROOT/sonic-cli-alias.py set_sonic_device_metadata_sonic_device_metadata_device_metadata_device_metadata_list_intf_naming_mode "standard"
 else
 python3 $SONIC_CLI_ROOT/sonic-cli-alias.py set_sonic_device_metadata_sonic_device_metadata_device_metadata_device_metadata_list_intf_naming_mode "standard-ext"
 fi
 </ACTION>
    </COMMAND>
    <COMMAND name="no interface-naming" access="netadmin" help="Interface naming" test="-z ${__in_session}">
      <PARAM name="standard" help="Disable interface naming standard mode" ptype="SUBCOMMAND" mode="subcommand"> </PARAM>
      <ACTION> python3 $SONIC_CLI_ROOT/sonic-cli-alias.py del_sonic_device_metadata_sonic_device_metadata_device_metadata_device_metadata_list_intf_naming_mode "native"
 </ACTION>
    </COMMAND>
  </VIEW>
  <VIEW name="enable-view">
    <COMMAND name="show interface-naming" help="Display interface naming mode">
      <ACTION> python3 $SONIC_CLI_ROOT/sonic-cli-alias.py get_sonic_device_metadata_sonic_device_metadata_device_metadata_device_metadata_list_intf_naming_mode alias.j2 ${__full_line} </ACTION>
      <xi:include href="include/pipe.xml"/>
    </COMMAND>
  </VIEW>
</CLISH_MODULE>
