<!-- 1st pipe -->
<PARAM xmlns="http://www.dellemc.com/sonic/XMLSchema"
    name="1_pipe"
    value="|"
    help="Pipe through a command"
    ptype="SUBCOMMAND"
    order="true"
    optional="true"
    mode="subcommand">
    <PARAM name="echo"
	help="echo the string to next user input."
	ptype="SUBCOMMAND"
        mode="subcommand">
        <PARAM name="1_LINE"
	    help="enter comma seperated user input values."
	    ptype="STRING_WITH_PIPE">
        </PARAM>
    </PARAM>
</PARAM>
<!-- end of 1st pipe -->
